# Copy to apps/web/.env.local for local overrides. All are optional.

# Intruva API (FastAPI). Leave empty to run in demo mode (on-device rule-based engine).
NEXT_PUBLIC_INTRUVA_API_URL=

# Optional pilot feedback form (e.g. a Google/Tally form). Receives rating, task, and mode only — never prompt text.
NEXT_PUBLIC_FEEDBACK_URL=
