{
  "name": "intruva",
  "private": true,
  "description": "Intruva — prompt intelligence: web app, developer API, Chrome extension, and MCP server on one shared engine.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "test": "npm test -w @intruva/engine",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.9"
  }
}
