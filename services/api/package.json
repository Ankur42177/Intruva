{
  "name": "@intruva/api",
  "version": "0.1.0",
  "private": true,
  "description": "Intruva Developer API \u2014 a Cloudflare Worker serving the shared @intruva/engine over HTTPS (analyze, optimize, security scan).",
  "type": "module",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "smoke": "bash examples/curl.sh",
    "keys:create": "node ../../scripts/create-api-key.mjs",
    "bench": "node --import tsx scripts/bench-cpu.ts --warmup",
    "bench:no-warmup": "node --import tsx scripts/bench-cpu.ts"
  },
  "dependencies": {
    "@intruva/engine": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^22",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "wrangler": "4.166.0"
  }
}
